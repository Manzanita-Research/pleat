{
  "name": "pleat-pkg",
  "private": true,
  "type": "module",
  "scripts": {
    "pack": "pkg pack --group '@pleat=../packages/*' --rebuild-all-path 'pkg/**'",
    "publish": "pkg publish",
    "setup": "alchemy profile edit --add Cloudflare",
    "deploy": "alchemy deploy --stage prod",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@alchemy.run/pkg": "2.0.0-beta.83",
    "@effect/platform-node": "4.0.0",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.0"
  }
}
