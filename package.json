{
  "name": "pleat-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "bench": "node --conditions=@pleat/source bench/render.ts",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:browser && pnpm site:build"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0",
    "@pleat/core": "workspace:*",
    "@pleat/foldkit": "workspace:*",
    "@types/node": "24.19.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0",
    "fast-check": "4.10.2",
    "foldkit": "0.167.0",
    "playwright-core": "1.64.0",
    "tailwind-merge": "3.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
