{
  "name": "pleat-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "bench": "pnpm --dir bench run bench",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:browser && pnpm site:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --dir site lint",
    "chromium:install": "pnpm --dir test/browser exec playwright-core install chromium"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
